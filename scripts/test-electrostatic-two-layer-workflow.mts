import assert from 'node:assert/strict';
import {test} from 'node:test';
import {TwoLayerExecutionSession,TwoLayerExecutionQuota} from '../simulation-bridge/electrostaticTwoLayerExecutionSession.mts';
import {TWO_LAYER_PUBLIC_EXECUTION_ENABLED,twoLayerWorkflowRequestSchema} from '../simulation-bridge/electrostaticTwoLayerWorkflow.mts';
// Synthetic control metadata only. No native, protected, human or physics proof.
const hash=(n:string)=>'sha256:'+n.repeat(64),jobId='electrical_00000000-0000-4000-8000-000000000000';
const approval:any={schema:'tunacad-electrostatic-two-layer-approval/0.1',studyId:'unit-study',projectRevision:'unit-rev',sourceEpoch:1,sessionBinding:hash('1'),sourceDigest:hash('2'),requestDigest:hash('3'),preparationReceiptDigest:hash('4'),domains:['a','b'].map((domainId,i)=>({domainId,bodyId:'body-'+domainId,materialId:'mat-'+domainId,absolutePermittivityFPerM:(i+1)*1e-11,permittivityUnit:'F/m',provenance:{kind:'custom',reference:'Synthetic unit material',revision:'1'}})),electrodes:[{domainId:'a',faceId:'left',potentialV:0,unit:'V'},{domainId:'b',faceId:'right',potentialV:100,unit:'V'}],interfaceFaces:['a-interface','b-interface'],mesh:{digest:hash('5'),nodes:10,elements:4,sharedNodes:6,matchedFacets:2,interfaceAreaMm2:1}};
const grant={authorizationId:'a'.repeat(64),bridgeSessionToken:'b'.repeat(64)};
function fixture(admitted=true,quota?:TwoLayerExecutionQuota){let current=true,fresh=true,submitted=0,authorized=0,cancelled=0,reads=0,clock=1,wait:Promise<void>|null=null;let state:any={jobId,state:'queued',phase:'queued',cleanupConfirmed:true,failureCode:null};
 const provider:any={submit:async()=>{submitted++;return {...state};},getStatus:async()=>{reads++;return {...state};},cancel:async()=>{cancelled++;state={...state,state:'cancelled',phase:'cancelled'};return {...state};},getResult:async()=>null,getElectricalPresentation:async()=>{throw Error('No synthetic physics');},getElectricalFieldPage:async()=>{throw Error('No synthetic fields');}};
 const owner=new TwoLayerExecutionSession(approval,{provider,quota,now:()=>clock,assertSession(){if(!current)throw Error('Session lost');},verifySource:async()=>{if(!fresh)throw Error('Source changed');},privateExecutionAdmitted:()=>admitted,authorize:async()=>{authorized++;if(wait)await wait;return {state:'pre_dispatch_admitted_no_solver',studyId:approval.studyId,sourceDigest:approval.sourceDigest,providerDispatched:false,authorizationExpiresAt:100};}});
 return {owner,provider,get submitted(){return submitted;},get authorized(){return authorized;},get cancelled(){return cancelled;},get reads(){return reads;},setFresh(v:boolean){fresh=v;},setCurrent(v:boolean){current=v;},setClock(v:number){clock=v;},setWait(v:Promise<void>){wait=v;},setState(v:any){state={...state,...v};}};
}
test('production admission fuse and choices-only messages fail closed before authorization',async()=>{assert.equal(TWO_LAYER_PUBLIC_EXECUTION_ENABLED,false);const f=fixture(false);await assert.rejects(f.owner.submit(grant),/PUBLIC_EXECUTION_CLOSED/);assert.equal(f.authorized,0);assert.equal(f.submitted,0);for(const operation of ['submit','field'])assert.throws(()=>twoLayerWorkflowRequestSchema.parse({operation,studyId:approval.studyId,grant,mesh:{},deck:'injected'}));});
test('concurrent or repeated submission cannot authorize or dispatch twice',async()=>{const f=fixture();let resume!:()=>void;f.setWait(new Promise<void>(r=>resume=r));const first=f.owner.submit(grant);await assert.rejects(f.owner.submit(grant),/already attempted/);resume();const job=await first;assert.equal(job.status.jobId,jobId);assert.equal(f.authorized,1);assert.equal(f.submitted,1);await assert.rejects(f.owner.submit(grant),/already attempted/);});
test('source/session changes and expired authorization stop submission; job ownership is exact',async()=>{for(const kind of ['source','session','expired']){const f=fixture();if(kind==='source')f.setFresh(false);if(kind==='session')f.setCurrent(false);if(kind==='expired')f.setClock(101);await assert.rejects(f.owner.submit(grant));assert.equal(f.submitted,0);}const f=fixture();await f.owner.submit(grant);await assert.rejects(f.owner.status(jobId.replace('000000000000','000000000001')),/not owned/);assert.equal(f.reads,0);f.setFresh(false);await assert.rejects(f.owner.status(jobId),/Source changed/);await f.owner.cancel(jobId);assert.equal(f.cancelled,1);});
test('shared quota preserves two active slots and requires confirmed cleanup',async()=>{const quota=new TwoLayerExecutionQuota(),a=fixture(true,quota),b=fixture(true,quota),c=fixture(true,quota);await a.owner.submit(grant);await b.owner.submit(grant);await assert.rejects(c.owner.submit(grant),/shared job limit/);a.setState({state:'failed',cleanupConfirmed:false});await a.owner.status(jobId);await assert.rejects(fixture(true,quota).owner.submit(grant),/shared job limit/);a.setState({cleanupConfirmed:true});await a.owner.status(jobId);await fixture(true,quota).owner.submit(grant);});
test('session forgetting cancels active work but never resets cumulative job quota',async()=>{const quota=new TwoLayerExecutionQuota();for(let i=0;i<16;i++){const f=fixture(true,quota);await f.owner.submit(grant);await f.owner.forget();assert.equal(f.cancelled,1);await assert.rejects(f.owner.status(jobId),/revoked/);}await assert.rejects(fixture(true,quota).owner.submit(grant),/shared job limit/);});
test('page bounds and missing completion reject without exposing fields',async()=>{const f=fixture();await f.owner.submit(grant);assert.equal(await f.owner.result(jobId),null);await assert.rejects(f.owner.field(jobId,'foreign','0',129),/bounds/);await assert.rejects(f.owner.field(jobId,'foreign','00',128),/bounds/);await assert.rejects(f.owner.field(jobId,'foreign','0',128),/unavailable/);});
test('read-budget boundary never prevents owned cancellation',async()=>{const f=fixture();await f.owner.submit(grant);for(let i=0;i<4096;i++)await f.owner.status(jobId);await assert.rejects(f.owner.status(jobId),/read limit/);assert.equal((await f.owner.cancel(jobId)).status.state,'cancelled');assert.equal(f.cancelled,1);});
