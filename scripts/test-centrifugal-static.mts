const translated=structuredClone(model);translated.nodes=translated.nodes.map(p=>[p[0]+31,p[1]-12,p[2]+8]);const translatedForces=centrifugalNodalLoads(translated as any,7850,{...rotation,axisPointMm:[31,-12,8]});for(const [n,f]of forces)f.forEach((x,i)=>assert(Math.abs(x-translatedForces.get(n)![i])<1e-12));
