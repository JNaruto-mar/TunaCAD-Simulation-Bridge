const fixed=[0,2,3,6,8,7],fixedForce=sum(fixed),rf=total.map((x,i)=>-x+fixedForce[i]);
const dat=['displacements for set NALL and time 1',...model.nodes.map((p,n)=>(n+1)+' '+(fixed.includes(n)?'0 0 0':'.001 0 0')),'stresses for set EALL and time 1','1 1 10 0 0 0 0 0','total force for set REACTION_001 and time 1',rf.join(' '),'volume for set EALL and time 1','0.16666666666666666'].join('\n');
const run:any={request,model,providerRunId:'synthetic-parser-run',submittedAt:request.preparedAt};const parsed=parseCalculiXDatV2(dat,model,['REACTION_001'],true),normalized=normalizeLinearStaticResult(run,parsed,'unit','1','2.16');validateNeutralSimulationResultV2(normalized.result,request);assert.equal(normalized.result.review.engineeringUsePermitted,false);assert(normalized.result.warnings.some(w=>w.code==='SIMULATION_CENTRIFUGAL_PREVIEW'));assert.equal(normalized.datasets.size,2);
