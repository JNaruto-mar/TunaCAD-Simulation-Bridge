assert.throws(()=>parseCalculiXDatV2(dat.replace('0.16666666666666666',''),model,['REACTION_001'],true));
assert.throws(()=>parseCalculiXDatV2(dat.replace('1 1 10 0 0 0 0 0','1 1 NaN 0 0 0 0 0'),model,['REACTION_001'],true));
