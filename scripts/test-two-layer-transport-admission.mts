import assert from 'node:assert/strict';
import { approveTwoLayerInTerminal } from '../simulation-bridge/twoLayerTerminalApproval.mts';
import {test} from 'node:test';
import {createHmac,randomBytes} from 'node:crypto';
import {request as httpRequest} from 'node:http';
import {companionUpgradeAllowed} from '../simulation-bridge/companionTransportAdmission.mts';
import {startSimulationBridge} from '../simulation-bridge/server.mts';
const h=(n:string)=>'sha256:'+n.repeat(64);
// Controlled metadata and terminal decision stub only; no native/human evidence.
const approval:any={schema:'tunacad-electrostatic-two-layer-approval/0.1',studyId:'two-layer-security-unit',projectRevision:'unit',sourceEpoch:1,sessionBinding:h('1'),sourceDigest:h('2'),requestDigest:h('3'),preparationReceiptDigest:h('4'),domains:['a','b'].map((domainId,i)=>({domainId,bodyId:'body-'+domainId,materialId:'mat-'+domainId,absolutePermittivityFPerM:(i+1)*1e-11,permittivityUnit:'F/m',provenance:{kind:'custom',reference:'Synthetic security unit',revision:'1'}})),electrodes:[{domainId:'a',faceId:'a-left',potentialV:0,unit:'V'},{domainId:'b',faceId:'b-right',potentialV:100,unit:'V'}],interfaceFaces:['a-interface','b-interface'],mesh:{digest:h('5'),nodes:10,elements:4,sharedNodes:6,matchedFacets:2,interfaceAreaMm2:1}};
test('Companion upgrade denies rebinding Host, public/untrusted Origin, malformed URL and token confusion',()=>{const good={remoteAddress:'127.0.0.1',host:'127.0.0.1:4738',origin:'http://127.0.0.1:8080',requestUrl:'/browser?token=unit-secret',port:4738,token:'unit-secret'};assert(companionUpgradeAllowed(good));assert(companionUpgradeAllowed({...good,host:'localhost:4738',origin:'http://localhost:8080'}));for(const changes of [{remoteAddress:'10.0.0.1'},{host:'evil.test:4738'},{host:'127.0.0.1:9999'},{origin:'https://tunacad.com'},{origin:'https://tunacad.com.evil.test'},{origin:'null'},{origin:'http://localhost.evil.test:8080'},{origin:'http://127.0.0.1:8080/path'},{origin:undefined},{requestUrl:'/browser?token=wrong'},{requestUrl:'/browser?token=unit-secret&token=unit-secret'},{requestUrl:'/other?token=unit-secret'},{requestUrl:'http://127.0.0.1:4738/browser?token=unit-secret'},{requestUrl:'/browser?token=unit-secret#fragment'}])assert.equal(companionUpgradeAllowed({...good,...changes}),false,JSON.stringify(changes));});
async function setup(){let approves=0;const b=await startSimulationBridge({port:0,provider:null,readiness:{ready:false,meshing:{ready:true},solving:{ready:true}} as any,approve:async()=>{approves++;return true;}});const origin='https://tunacad.com';const raw=(path:string,method='GET',body?:unknown,token?:string,headers:Record<string,string>={})=>fetch(b.url+path,{method,headers:{Origin:origin,...(token?{Authorization:'Bearer '+token}:{}),...(body===undefined?{}:{'Content-Type':'application/json'}),...headers},...(body===undefined?{}:{body:JSON.stringify(body)})});const challenge=randomBytes(32).toString('hex'),proof=createHmac('sha256',b.pairingCode).update('client:'+challenge).digest('hex');const paired=await raw('/v1/pair','POST',{challenge,proof});assert.equal(paired.status,200);const token=(await paired.json() as any).sessionToken;return {b,raw,token,get approves(){return approves;}};}
async function grant(f:Awaited<ReturnType<typeof setup>>){const response=await f.raw('/v1/two-layer/authorizations','POST',approval,f.token);assert.equal(response.status,202);return (await response.json() as any).authorizationId;}
function partial(f:Awaited<ReturnType<typeof setup>>,path:string,body:any){const text=JSON.stringify(body);let finish!:()=>void;const promise=new Promise<number>((resolve,reject)=>{const req=httpRequest(f.b.url+path,{method:'POST',headers:{Origin:'https://tunacad.com',Authorization:'Bearer '+f.token,'Content-Type':'application/json','Content-Length':Buffer.byteLength(text)}},res=>{res.resume();res.on('end',()=>resolve(res.statusCode!));});req.on('error',reject);req.write(text.slice(0,1));finish=()=>req.end(text.slice(1));});return {promise,finish};}
test('Bridge denies wrong Origin/Host/token and does not expose a public two-layer job route',async()=>{const f=await setup();try{for(const Origin of ['null','https://evil.test','https://tunacad.com.evil.test','http://localhost:8080'])assert.equal((await f.raw('/v1/two-layer/authorizations','POST',approval,f.token,{Origin})).status,403);assert.equal((await f.raw('/v1/two-layer/authorizations','POST',approval,'0'.repeat(64))).status,401);
// Node fetch normalizes Host; send this particular wire-level negative with http.
const wrongHost=await new Promise<number>((resolve,reject)=>{const req=httpRequest(f.b.url+'/v1/two-layer/authorizations',{method:'POST',headers:{Host:'evil.test',Origin:'https://tunacad.com',Authorization:'Bearer '+f.token,'Content-Type':'application/json'}},res=>{res.resume();res.on('end',()=>resolve(res.statusCode!));});req.on('error',reject);req.end(JSON.stringify(approval));});assert.equal(wrongHost,403);assert.equal(f.approves,0);assert.equal((await f.raw('/v1/two-layer/jobs','POST',{},f.token)).status,404);}finally{await f.b.close();}});
test('two simultaneous body reads consume one Bridge grant exactly once',async()=>{const f=await setup();try{const id=await grant(f),path='/v1/two-layer/authorizations/'+id+'/consume',a=partial(f,path,approval),b=partial(f,path,approval);await new Promise(r=>setTimeout(r,25));a.finish();b.finish();assert.deepEqual((await Promise.all([a.promise,b.promise])).sort(),[200,403]);assert.equal(f.approves,1);}finally{await f.b.close();}});
test('session revocation during authorization or consume body I/O cannot issue or consume a grant',async()=>{for(const operation of ['issue','consume']){const f=await setup();try{const id=operation==='consume'?await grant(f):null,path=id?'/v1/two-layer/authorizations/'+id+'/consume':'/v1/two-layer/authorizations',p=partial(f,path,approval);await new Promise(r=>setTimeout(r,25));assert.equal((await f.raw('/v1/session','DELETE',undefined,f.token)).status,200);p.finish();assert([401,403].includes(await p.promise));assert.equal(f.approves,operation==='consume'?1:0);}finally{await f.b.close();}}});
test('real two-layer terminal helper refuses noninteractive approval without asking a question', {skip:Boolean(process.stdin.isTTY&&process.stdout.isTTY)}, async()=>{
  let questions=0;
  await assert.rejects(approveTwoLayerInTerminal({} as any,new AbortController().signal,
    {question(){questions++;return Promise.resolve('approve');}} as any),/real interactive terminal/);
  assert.equal(questions,0);
});
